# Database — get this from Neon (or any PostgreSQL provider)
DATABASE_URL=jdbc:postgresql://your-host/your-db-name
DATABASE_USERNAME=your-db-username
DATABASE_PASSWORD=your-db-password

# JWT — generate a strong random secret (min 32 characters, Base64 encoded)
JWT_SECRET_KEY=your-base64-encoded-secret-key

# Set to "validate" in production so Hibernate never auto-modifies your schema
DDL_AUTO=update
